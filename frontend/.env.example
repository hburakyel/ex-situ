# Frontend (Next.js) environment variables

# Strapi API
NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api
NEXT_PUBLIC_PROTOMAPS_KEY=

# Analytics (optional, self-hosted Umami — see docs/ANALYTICS.md).
# Leave empty to load no tracker. Read at build time.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Comma-separated hostnames to count, e.g. exsitu.app (keeps localhost out)
NEXT_PUBLIC_UMAMI_DOMAINS=
