# Backend API base URL (Strapi + custom geospatial API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1337/api

# Public site URL, used for sitemap/canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protomaps (PMTiles) basemap
NEXT_PUBLIC_PROTOMAPS_KEY=
NEXT_PUBLIC_PROTOMAPS_PMTILES_URL=

# Server-side only — Strapi API token used by the app/api/proxy/* routes
STRAPI_API_TOKEN=

# Expected Origin header for the Strapi webhook route (app/api/webhook/strapi)
STRAPI_WEBHOOK_ORIGIN=http://localhost:1337
