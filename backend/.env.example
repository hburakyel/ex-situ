# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Strapi secrets — generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS is a comma-separated list; Strapi will not boot without it.
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# Database (PostgreSQL + PostGIS)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=exsitu_db
DATABASE_USERNAME=exsitu
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public

# CORS — the frontend origin allowed to call this API
FRONTEND_URL=http://localhost:3000

# Used by backend/scripts/*.js to call this API's own REST endpoints
STRAPI_BASE_URL=http://127.0.0.1:1337/api/museum-objects
API_TOKEN=
